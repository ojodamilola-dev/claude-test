# Meeting Briefing Agent Configuration

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Model selection (default: claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Optional: Max tokens for agent responses (default: 2048)
# MAX_TOKENS=2048

# Optional: Debug mode (default: false)
# DEBUG=false
